#!/bin/bash
#SBATCH --account=MST113186
#SBATCH --job-name=mmp_analyze
#SBATCH --partition=normal
#SBATCH --nodes=1
#SBATCH --gpus-per-node=4
#SBATCH --cpus-per-task=8
#SBATCH --mem=800G
#SBATCH --time=24:00:00
#SBATCH --output=logs/mmp_analyze_%j.out
#SBATCH --error=logs/mmp_analyze_%j.err
#
# Run v4 analysis stages 03-13 on the linker-inclusive pairs.mmpdb.
# Submit from home:
#   sbatch job_analyze.pbs

set -euo pipefail

cd "${SLURM_SUBMIT_DIR:-/home/r12524031}"
mkdir -p logs results_linker/aggregated results_linker/figures

LOG_FILE="logs/mmp_analyze_${SLURM_JOB_ID}.log"
ln -sfn "$(basename "$LOG_FILE")" logs/mmp_analyze_latest.log
exec > >(stdbuf -oL -eL tee -a "$LOG_FILE") 2>&1

echo "[$(date '+%F %T')] Job start: ${SLURM_JOB_ID}"
echo "[$(date '+%F %T')] Host: $(hostname)"
df -h /home/r12524031 /work/r12524031 | sed 's/^/  /'
free -h | head -2

source /home/r12524031/miniconda3/bin/activate
conda activate mmp
export PYTHONUNBUFFERED=1
PY=python

# Quiet RDKit warnings if any stage touches RDKit
"$PY" - <<'PY' || true
from rdkit import RDLogger, rdBase
RDLogger.DisableLog("rdApp.warning")
rdBase.DisableLog("rdApp.warning")
print("RDKit warning log disabled")
PY

DB="results_linker/pairs.mmpdb"
DB_REAL="/work/r12524031/mmp_linker/results_linker/pairs.mmpdb"
if [[ ! -e "$DB" && -f "$DB_REAL" ]]; then
    ln -sfn "$DB_REAL" "$DB"
fi
if [[ ! -e "$DB" ]]; then
    echo "ERROR: $DB missing (expected symlink to $DB_REAL)" >&2
    exit 1
fi
echo "[$(date '+%F %T')] DB: $DB -> $(readlink -f "$DB")"
ls -lah "$DB"

# Stage inputs
for f in master.csv candidates.csv data/candidates.txt data/properties.tsv data/mols_linker.fragments; do
    if [[ ! -f "$f" ]]; then
        echo "ERROR: required input missing: $f" >&2
        exit 1
    fi
done

run_stage () {
    local n="$1"; shift
    echo
    echo "============================================================"
    echo "[$(date '+%F %T')] STAGE $n: $*"
    echo "============================================================"
    "$PY" "$@"
    echo "[$(date '+%F %T')] STAGE $n DONE"
}

run_stage 03 03_fragment_goodness.py --db "$DB"
run_stage 04 04_mine_transformations.py --db "$DB"
run_stage 05 05_context_rules.py --db "$DB"
run_stage 06 06_extract_pairs.py --db "$DB"
run_stage 07 07_candidate_endpoints.py
run_stage 08 08_aggregate.py
run_stage 09 09_correlations.py
run_stage 10 10_candidate_profiles.py
run_stage 11 11_recommend.py
run_stage 12 12_figures.py
run_stage 13 13_layer_report.py

echo
echo "[$(date '+%F %T')] ALL STAGES COMPLETE"
echo "---- key outputs ----"
ls -lah results_linker/fragment_goodness.csv results_linker/global_scales.csv \
        results_linker/transformations.csv results_linker/anchored_pairs.csv \
        results_linker/candidate_rule_matrix.csv results_linker/recommendations.csv \
        results_linker/figures/*.png 2>&1 | sed 's/^/  /'

echo "[$(date '+%F %T')] Job end"
